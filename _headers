/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cache-Control: public, max-age=3600, must-revalidate

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Widget embebible: se puede incluir en otros sitios (iframe) y los datos se pueden leer desde cualquier origen
/widget/embed*
  ! X-Frame-Options

# Los datos cambian varias veces al dia: cache corta (5 min) para que el sitio y los widgets se actualicen rapido
/data/*
  ! Cache-Control
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *
